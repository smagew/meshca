# Copy to .env (never committed) and fill in. Generate each password with: openssl rand -hex 24

# Directory for database files. Use a dedicated volume, not the root filesystem.
MESHCA_DATA_DIR=/srv/meshca/data

POSTGRES_PASSWORD=
# The observer publishes with this password (user "observer").
MQTT_OBSERVER_PASSWORD=
# The collector subscribes with this one (user "collector").
MQTT_COLLECTOR_PASSWORD=

# Grafana: read-only database user for the dashboards and the admin login for changing them.
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Dashboards are open for reading without a login on this port; keep it inside the local network.
# MESHCA_GRAFANA_PORT=3001
# MESHCA_GRAFANA_BIND=0.0.0.0
# Time zone for "hour of the day" charts, e.g. Europe/Berlin.
# MESHCA_TIMEZONE=UTC

# Broker port the observer connects to (LAN). 1883 is left free for other software on the host.
MESHCA_MQTT_PORT=1884
# MESHCA_MQTT_BIND=0.0.0.0
# PostgreSQL is reachable from the host only (use an SSH tunnel for remote analysis).
# MESHCA_PG_BIND=127.0.0.1
# MESHCA_PG_PORT=5433
# MESHCA_MQTT_TOPICS=meshcore/#

# Hashtag channels to decrypt besides Public, comma separated. Channels mentioned as #name in decrypted
# messages are added automatically.
# Write the names without "#": in this file " #" starts a comment.
# MESHCA_CHANNELS=test,bot
# Decrypted channel texts are removed after this many days (sender, time, channel and length stay).
# MESHCA_TEXT_RETENTION_DAYS=30

# Collection alerts are always written to the worker log and to the table monitor_event. To receive them:
# Telegram: create a bot with @BotFather, send the bot any message, see docs/DEPLOY.md for the chat id.
# MESHCA_ALERT_TELEGRAM_BOT_TOKEN=
# MESHCA_ALERT_TELEGRAM_CHAT_ID=
# and/or a URL that accepts a JSON POST: {"check", "state", "title", "message"}.
# MESHCA_ALERT_WEBHOOK_URL=
# No status message from the observer for this long = it is not connected to our broker.
# MESHCA_ALERT_STATUS_GAP_MIN=15
# The observer is connected but no packet arrived for this long.
# MESHCA_ALERT_PACKET_GAP_MIN=30

# Node resolution (which node stands behind a path prefix): how often it runs and over how many days of paths.
# MESHCA_RESOLVE_INTERVAL_MIN=60
# MESHCA_RESOLVE_WINDOW_DAYS=30
