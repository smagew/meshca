  {
   "id": 7,
   "type": "timeseries",
   "title": "Занятость эфира",
   "description": "Счётчик радио учитывает всё, что оно слышало, включая непрочитанное. Вторая линия — расчёт по принятым пакетам; разница между ними — передачи, которые прочитать не удалось.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(ingested_at, $__interval), 'по счётчику радио' AS metric, 100.0 * sum(d_rx_air) / nullif(sum(d_uptime), 0) AS value FROM v_observer_stats_delta WHERE $__timeFilter(ingested_at) GROUP BY 1 ORDER BY 1"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(r.received_at, $__interval), 'по разобранным пакетам' AS metric, 100.0 * sum(lora_airtime_ms(r.packet_len, v.sf, v.bw_khz, v.cr)) / $__interval_ms AS value FROM reception r CROSS JOIN v_radio v WHERE $__timeFilter(r.received_at) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "showPoints": "auto",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
