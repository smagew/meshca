    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT 100.0 * sum(d_rx_air) / nullif(sum(d_uptime), 0) FROM v_observer_stats_delta WHERE $__timeFilter(ingested_at)"
