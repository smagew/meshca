  {
   "id": 10,
   "type": "timeseries",
   "title": "Уровень сигнала соседей (RSSI)",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(received_at, $__interval), label AS metric, avg(rssi) AS value FROM v_hop_resolved WHERE $__timeFilter(received_at) AND from_end = 0 GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dBm",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "showPoints": "auto",
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 11,
   "type": "table",
   "title": "Сигнал по соседям",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT label AS \"узел\", string_agg(DISTINCT prefix, ' ' ORDER BY prefix) AS \"префиксы\", count(*) AS \"приёмов\", min(rssi) AS \"RSSI мин\", round(avg(rssi)) AS \"RSSI средн\", max(rssi) AS \"RSSI макс\", round(min(snr)::numeric, 1) AS \"SNR мин\", round(avg(snr)::numeric, 1) AS \"SNR средн\", round(max(snr)::numeric, 1) AS \"SNR макс\" FROM v_hop_resolved WHERE $__timeFilter(received_at) AND from_end = 0 GROUP BY 1 ORDER BY 3 DESC LIMIT 50"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Эфирное время по типам пакетов, секунд",
   "description": "Какие типы пакетов занимают эфир вокруг observer'а.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(r.received_at, $__interval), payload_type_name(p.payload_type) AS metric, sum(lora_airtime_ms(r.packet_len, v.sf, v.bw_khz, v.cr)) / 1000 AS value FROM reception r JOIN packet p ON p.hash = r.packet_hash CROSS JOIN v_radio v WHERE $__timeFilter(r.received_at) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "lineWidth": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  }
