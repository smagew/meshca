    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT at AS \"время\", CASE name WHEN 'observer_link' THEN 'связь с observer''ом' ELSE 'пакеты' END AS \"проверка\", CASE state WHEN 'ok' THEN 'норма' ELSE 'сбой' END AS \"состояние\", message AS \"сообщение\", notified AS \"отправлено\" FROM monitor_event ORDER BY id DESC LIMIT 50"
