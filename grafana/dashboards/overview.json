  {
   "id": 11,
   "type": "timeseries",
   "title": "Уровень сигнала соседей (RSSI)",
   "description": "По последнему узлу пути: это ретранслятор, которого observer слышит сам.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroupAlias(received_at, $__interval), coalesce(last_hop, 'напрямую') AS metric, avg(rssi) AS value FROM reception WHERE $__timeFilter(received_at) AND route_type IN (0, 1) GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
