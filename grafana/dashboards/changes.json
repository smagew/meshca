  {
   "id": 5,
   "type": "table",
   "title": "События справочника",
   "description": "Сначала изменения, потом новые узлы. «То же имя, другой ключ»: устройство перепрошили, у владельца второе устройство или кто-то назвался чужим именем — в колонках «было» и «стало» начала ключей.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT at AS \"когда\", label AS \"узел\", event AS \"что\", old AS \"было\", new AS \"стало\", left(pubkey, 10) AS \"ключ\" FROM v_node_event WHERE $__timeFilter(at) ORDER BY (event = 'новый узел'), at DESC LIMIT 500"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  },
  {
   "id": 6,
   "type": "table",
   "title": "Часы узлов",
   "description": "Разница между временем, которое узел пишет в своём объявлении, и временем, когда мы его услышали (медиана по объявлениям узла). Плюс — часы узла спешат, минус — отстают. Сбитые часы не мешают сети, но путают время в сообщениях этого узла.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT label AS \"узел\", node_role_name(role) AS \"роль\", adverts AS \"объявлений\", CASE WHEN abs(offset_s) < 120 THEN 'верно' WHEN abs(offset_s) < 3600 THEN round((offset_s / 60)::numeric) || ' мин' WHEN abs(offset_s) < 172800 THEN round((offset_s / 3600)::numeric, 1) || ' ч' ELSE round((offset_s / 86400)::numeric) || ' дн' END AS \"часы узла\", last_advert AS \"последнее объявление\" FROM v_node_clock ORDER BY abs(offset_s) DESC LIMIT 500"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  }
 ]
