  {
   "id": 7,
   "type": "table",
   "title": "Кто с кем: пары личных пакетов",
   "description": "Если под байт подходит несколько известных узлов, кто именно из них — не определено. «Неизвестен» — ни одного объявления с таким началом ключа мы не слышали.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT hash_names(a) AS \"сторона A\", hash_names(b) AS \"сторона B\", count(*) AS \"сессий\", sum(packets) AS \"пакетов\", sum(a_to_b) AS \"A → B\", sum(b_to_a) AS \"B → A\", round(percentile_cont(0.5) WITHIN GROUP (ORDER BY median_response_s)::numeric, 1) AS \"ответ, с\", max(ended_at) AS \"последний раз\" FROM dm_session WHERE $__timeFilter(started_at) GROUP BY a, b ORDER BY 4 DESC LIMIT 300"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  },
  {
   "id": 8,
   "type": "table",
   "title": "Последние сессии",
   "description": "«a:REQ → b:RESPONSE» — A спросил, B ответил. REQ — запрос (вход, статус, телеметрия), RESPONSE — ответ, TXT_MSG — личное сообщение, PATH — сообщённый обратный путь.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT started_at AS \"начало\", round(extract(epoch FROM ended_at - started_at)) AS \"длилась, с\", hash_names(a) AS \"A\", hash_names(b) AS \"B\", packets AS \"пакетов\", left(array_to_string(kinds, ' → '), 200) AS \"ход\" FROM dm_session WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 300"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  },
  {
   "id": 9,
   "type": "table",
   "title": "Что за чем следует в сессиях",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "WITH step AS ( SELECT s.id, k.kind, k.n FROM dm_session s, unnest(s.kinds) WITH ORDINALITY AS k(kind, n) WHERE $__timeFilter(s.started_at) ), pair AS ( SELECT substr(x.kind, 3) AS from_kind, CASE WHEN left(x.kind, 1) = left(y.kind, 1) THEN 'та же сторона' ELSE 'другая сторона' END AS who, substr(y.kind, 3) AS to_kind FROM step x JOIN step y ON y.id = x.id AND y.n = x.n + 1 ) SELECT from_kind AS \"после\", who AS \"кто\", to_kind AS \"идёт\", count(*) AS \"раз\", round(100.0 * count(*) / sum(count(*)) OVER (PARTITION BY from_kind)) AS \"% от «после»\" FROM pair GROUP BY 1, 2, 3 ORDER BY 1, 4 DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Каналы: кто кому отвечает",
   "description": "Упоминание @[имя] — точный признак обращения. Быстрый ответ — сообщение в течение 2 минут после сообщения другого; он бывает и случайным, поэтому рядом — сколько таких совпадений ожидалось бы при случайных временах. Отправитель взят из текста сообщения и протоколом не проверяется.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "meshca"
   },
   "gridPos": {
    "x": 12,
    "y": 26,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "meshca"
     },
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT channel AS \"канал\", source AS \"кто\", target AS \"кому\", mentions AS \"упоминаний\", quick AS \"быстрых ответов\", round(expected::numeric, 2) AS \"случайно ожидалось\", round((quick / nullif(expected, 0))::numeric, 1) AS \"во сколько раз чаще случая\" FROM channel_link ORDER BY mentions + quick DESC LIMIT 500"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
    },
    "overrides": []
   },
   "options": {
    "cellHeight": "sm",
    "showHeader": true
   }
  }
 ]
}
